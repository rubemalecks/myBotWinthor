TELEGRAM_BOT_TOKEN=  # Configure o token real pelo painel web depois de iniciar a API.
TELEGRAM_ADMIN_ID=123456789  # ID ficticio do Telegram do administrador principal.
BOT_DATA_DIR=  # Opcional: pasta persistente para usuarios e configuracoes; vazio cria myBotWinthor-dados ao lado do projeto.
ORACLE_HOST=192.0.2.10  # IP reservado para documentacao; substitua pelo host real do Oracle.
ORACLE_PORT=1521  # Porta padrao do listener Oracle.
ORACLE_SERVICE=WINTHORPRD  # Nome ficticio do service name Oracle.
ORACLE_USER=BOT_CONSULTA  # Usuario ficticio Oracle com permissao somente de consulta.
ORACLE_PASSWORD=SenhaFicticia_Exemplo2026  # Senha ficticia; substitua pela senha real do Oracle.
ORACLE_CLIENT_DIR=  # Vazio detecta oracle_client junto à API; sem essa pasta, usa Thin. Aceita caminho absoluto ou relativo à API.
WEB_ADMIN_USER=admin  # Usuario inicial para entrar no painel.
WEB_ADMIN_PASSWORD=admin  # Senha inicial solicitada; altere depois no painel.
WEB_SESSION_SECRET=  # Opcional: segredo que assina a sessao do painel; gere um valor proprio (veja README); vazio gera um novo ao iniciar.
WEB_ADMIN_HOST=0.0.0.0  # Escuta nas interfaces de rede do computador que executa o bot.
WEB_ADMIN_PORT=8765  # Porta HTTP do painel; o IP de acesso e informado no log ao iniciar.
WEB_ADMIN_URL=  # Opcional: URL anunciada quando houver um dominio ou endereco fixo.
WEB_HTTPS_ONLY=false  # Use true se o painel estiver atras de um proxy HTTPS.
